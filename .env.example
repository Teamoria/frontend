# Local development uses Laravel on port 8000. Production should set these to
# the public Laravel API origin, or leave same-origin deployments to use /api/v1.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_ORIGIN=http://localhost:8000
# Optional. Production can omit this when /api/v1/ai is proxied on the same domain,
# or set it to the public AI service origin. Do not use localhost in production.
VITE_AI_API_BASE_URL=
VITE_API_VERSION=v1
VITE_API_KEY=
VITE_INTERNAL_API_KEY=
VITE_INTERNAL_USER_ID=
VITE_INTERNAL_USER_ROLE=
VITE_INTERNAL_COMPANY_ID=
VITE_GOOGLE_CLIENT_ID=
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=api.teamoria.online
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
VITE_REVERB_AUTH_ENDPOINT=https://api.teamoria.online/broadcasting/auth
APP_PORT=3000
FRONTEND_URL=https://teamoria.online/
