# Laravel API. Keep the origin separate because broadcasting auth lives outside /api/v1.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_ORIGIN=http://localhost:8000
VITE_API_VERSION=v1
VITE_API_KEY=
VITE_GOOGLE_CLIENT_ID=

# Laravel Reverb. The app key is public; never expose REVERB_APP_SECRET to Vite.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
VITE_REVERB_AUTH_ENDPOINT=http://localhost:8000/broadcasting/auth
